DATABASE_URL=
OPENROUTER_API_KEY=
# Optional model overrides (defaults in backend/app/config.py)
LLM_MODEL_TEXT=
LLM_MODEL_TEXT_FALLBACKS=
LLM_MODEL_VISION=
LLM_MODEL_VISION_FALLBACKS=

# YouCam (Perfect Corp) media API — https://docs.perfectcorp.com
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# AI Image Generator model (1 unit/task, cheapest); see Unit Consumption pages
YOUCAM_IMAGE_MODEL=youcam-image-v2
YOUCAM_POLL_INTERVAL_SECONDS=2.0
YOUCAM_TIMEOUT_SECONDS=180.0
# Local dir where downloaded YouCam results are stored (served at /media)
MEDIA_DIR=./media
# live = real YouCam calls when building campaigns, passthrough = original photo only
MEDIA_MODE=passthrough
