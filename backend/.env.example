# Copy to .env and adjust. Never commit .env.

# SQLAlchemy database URL. Local dev default is SQLite; production uses Neon.
# Postgres example (pooled connection string, sslmode required):
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./eviral.db

# Enable FastAPI debug mode
DEBUG=false

# OpenRouter (https://openrouter.ai/keys). The repo root .env already holds
# OPENROUTER_API_KEY; copy it here only if you want a backend-local override.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Caption model; pick a free model from https://openrouter.ai/models?max_price=0
LLM_MODEL_TEXT=nvidia/nemotron-3.5-super-vl:free

# YouCam (Perfect Corp) media API — https://docs.perfectcorp.com.
# The repo root .env already holds YOUCAM_API_KEY; the backend reads it.
# Flow: File API upload -> async task -> poll -> result URL (valid ~2h) ->
# download immediately (uploads/results deleted within 24h).
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# AI Image Generator model: "youcam-image-v2" (1 unit/task, cheapest)
YOUCAM_IMAGE_MODEL=youcam-image-v2
YOUCAM_POLL_INTERVAL_SECONDS=2.0
YOUCAM_TIMEOUT_SECONDS=180.0
# Local dir where downloaded YouCam results are stored (served at /media)
MEDIA_DIR=./media
