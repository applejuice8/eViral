# Copy to .env and adjust. Never commit .env.

# SQLAlchemy database URL. Local dev default is SQLite; production uses Neon.
# Postgres example (pooled connection string, sslmode required):
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./eviral.db

# Enable FastAPI debug mode
DEBUG=false

# OpenRouter (https://openrouter.ai/keys). The repo root .env already holds
# OPENROUTER_API_KEY; copy it here only if you want a backend-local override.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Caption model; pick a free model from https://openrouter.ai/models?max_price=0
LLM_MODEL_TEXT=meta-llama/llama-3.3-70b-instruct:free
